{
  "name": "skilltrust-certificates",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run compile && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "compile": "node scripts/compile.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/app.js && node --check src/service.js && node --check src/certificate.js && node --check src/wallet.js"
  },
  "dependencies": {
    "ethers": "6.16.0",
    "jsqr": "1.4.0",
    "lucide": "0.468.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "ganache": "7.9.2",
    "solc": "0.8.30",
    "vite": "6.4.1"
  }
}
